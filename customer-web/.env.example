# ── Public ─────────────────────────────────────────────────────────────────
# Backend base URL. Required.
NEXT_PUBLIC_API_URL=http://localhost:5000

# App's own public origin (used in manifest / OG tags). Optional.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Default locale on first visit. One of "ar" | "en". Default "ar".
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# Web Push VAPID public key (Phase 8 onwards). Optional during scaffold.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Firebase (phone OTP + Google sign-in, Phase 1.4). Optional during scaffold.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
