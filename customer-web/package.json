    "@tanstack/react-query": "^5.62.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.562.0",
    "next": "16.1.1",
    "next-intl": "^4.12.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.69.0",
    "serwist": "^9.0.11",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.4",
    "zustand": "^5.0.9"
