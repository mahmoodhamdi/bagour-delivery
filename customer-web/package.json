{
  "name": "customer-web",
  "version": "0.0.0",
  "private": true,
  "description": "Bagour Delivery — customer-facing Next.js 16 PWA (Arabic + English).",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
