{
  "name": "driver-web",
  "version": "0.0.0",
  "private": true,
  "description": "Bagour Delivery — driver-facing Next.js 16 PWA (Arabic + English).",
  "scripts": {
    "dev": "next dev --turbopack --port 3001",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start --port 3001",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:component": "vitest run",
    "test:integration": "vitest run --include 'src/**/*.integration.test.{ts,tsx}'",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
