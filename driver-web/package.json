    "next-intl": "^4.12.0",
    "next-themes": "^0.4.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.69.0",
    "serwist": "^9.0.11",
    "sonner": "^2.0.7",
