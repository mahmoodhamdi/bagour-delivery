{
  "info": {
    "_postman_id": "bagour-delivery-api-v1",
    "name": "Bagour Delivery API",
    "description": "Complete API collection for Bagour Delivery food ordering platform.\n\n## Authentication\nMost endpoints require Bearer token authentication. Use the Login endpoints to obtain tokens.\n\n## Environments\n- Development: http://localhost:5000\n- Production: https://api.bagour-delivery.com",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
