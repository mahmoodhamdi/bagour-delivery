{
  "name": "@bagour/types",
  "version": "0.0.0",
  "private": true,
  "description": "Shared TypeScript types, constants, and Zod schemas for the Bagour Delivery web apps.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./schemas": {
      "types": "./src/schemas.ts",
      "default": "./src/schemas.ts"
    },
    "./constants": {
      "types": "./src/constants.ts",
      "default": "./src/constants.ts"
    }
  },
  "files": [
    "src/**/*"
  ],
  "scripts": {
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@bagour/config-tsconfig": "workspace:*",
    "typescript": "^5.9.3",
    "vitest": "^2.1.0"
  }
}
